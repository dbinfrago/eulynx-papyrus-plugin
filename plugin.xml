<plugin>
   <extension
         point="org.eclipse.gmf.runtime.common.ui.services.parserProviders">
      <ParserProvider
            class="com.eulynx.papyrus.specification.parsers.CustomTransitionParserProvider">
         <Priority
               name="Highest">
         </Priority>
      </ParserProvider>
      <ParserProvider
            class="com.eulynx.papyrus.specification.timing.DurationLinkParserProvider">
         <Priority
               name="Highest">
         </Priority>
      </ParserProvider>
   </extension>

   <extension
         point="org.eclipse.gmf.runtime.diagram.ui.editpartProviders">
      <editpartProvider
            class="com.eulynx.papyrus.specification.frame.DiagramFrameEditPartProvider">
         <Priority
               name="Highest">
         </Priority>
      </editpartProvider>
      <editpartProvider
            class="com.eulynx.papyrus.specification.statemachine.width.WidthAwareTransitionGuardEditPartProvider">
         <Priority
               name="Highest">
         </Priority>
      </editpartProvider>
      <editpartProvider
            class="com.eulynx.papyrus.specification.statemachine.region.NamedRegionCompartmentEditPartProvider">
         <Priority
               name="Highest">
         </Priority>
      </editpartProvider>
   </extension>

   <extension
         point="org.eclipse.ui.startup">
